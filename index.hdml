<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monthly Expense Calculator</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <div class="container">

    <h1>💰 Monthly Expense Calculator</h1>

    <!-- INCOME SECTION -->
    <div class="section">
      <h2>Step 1: Enter Your Monthly Income</h2>
      <label for="income">Monthly Income (₹):</label>
      <input type="number" id="income" placeholder="e.g. 30000" min="0">
    </div>

    <!-- EXPENSES SECTION -->
    <div class="section">
      <h2>Step 2: Enter Your Expenses</h2>

      <div class="expense-row">
        <label for="rent">🏠 Rent:</label>
        <input type="number" id="rent" placeholder="e.g. 10000" min="0">
      </div>

      <div class="expense-row">
        <label for="food">🍽️ Food & Groceries:</label>
        <input type="number" id="food" placeholder="e.g. 5000" min="0">
      </div>

      <div class="expense-row">
        <label for="travel">🚌 Travel / Transport:</label>
        <input type="number" id="travel" placeholder="e.g. 2000" min="0">
      </div>

      <div class="expense-row">
        <label for="entertainment">🎬 Entertainment:</label>
        <input type="number" id="entertainment" placeholder="e.g. 1500" min="0">
      </div>

      <div class="expense-row">
        <label for="education">📚 Education / Books:</label>
        <input type="number" id="education" placeholder="e.g. 1000" min="0">
      </div>

      <div class="expense-row">
        <label for="health">🏥 Health / Medicine:</label>
        <input type="number" id="health" placeholder="e.g. 500" min="0">
      </div>

      <div class="expense-row">
        <label for="other">📦 Other Expenses:</label>
        <input type="number" id="other" placeholder="e.g. 1000" min="0">
      </div>
    </div>
